  "description": "Local RetroArch-aware server for ROM playlists, thumbnails, and static game assets.",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkCommander27/RetroArchServer.git"
  },
  "keywords": [
    "retroarch",
