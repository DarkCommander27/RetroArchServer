    "libretro"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DarkCommander27/RetroArchServer/issues"
  },
  "homepage": "https://github.com/DarkCommander27/RetroArchServer#readme",
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
